# ──────────────────────────────────────────────
# Supabase — SurfAgencyMorocco Admin
# ──────────────────────────────────────────────
# 1. Go to https://supabase.com and create a project
# 2. Go to Project Settings > API
# 3. Copy your Project URL and anon/public key below
# 4. Rename this file to .env
# 5. In supabase-client.js, update SUPABASE_URL and SUPABASE_ANON_KEY
# 6. Run admin/schema.sql in Supabase SQL Editor

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

