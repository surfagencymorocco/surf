# ──────────────────────────────────────────────
# Supabase — SurfAgencyMorocco Admin
# ──────────────────────────────────────────────
# 1. Go to https://supabase.com and create a project
# 2. Go to Project Settings > API
# 3. Copy your Project URL and anon/public key below
# 4. Rename this file to .env
# 5. In supabase-client.js, update SUPABASE_URL and SUPABASE_ANON_KEY
# 6. Run admin/schema.sql in Supabase SQL Editor

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ──────────────────────────────────────────────
# Telegram notifications (optional)
# ──────────────────────────────────────────────
# Set TELEGRAM_ENABLED=true to activate.
# Get your bot token from @BotFather on Telegram.
# Get your chat ID by sending /start to your bot,
# then visit https://api.telegram.org/bot<TOKEN>/getUpdates
# These secrets are set on the send-email Edge Function, not here.

TELEGRAM_ENABLED=true
TELEGRAM_NOTIFY_ON_NEW_BOOKING=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ──────────────────────────────────────────────
# Admin credentials (create in Supabase Auth)
# ──────────────────────────────────────────────
# Go to Authentication > Users > Add User
# Email: admin@surfagencymorocco.com
# Password: Saskia34%
